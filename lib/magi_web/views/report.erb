<div class="report-container">
  <div class="report-header">
    <h1>THREAT INTELLIGENCE REPORT</h1>
    <h2>NERV INCIDENT RESPONSE - EP <%= @episode %></h2>
    <p>CLASSIFICATION: CONFIDENTIAL / EYES ONLY</p>
  </div>

  <button onclick="window.print()" style="margin-bottom: 20px; border: 1px solid #000; background: #fff; color: #000; display: block;" class="no-print">
    EXPORT TO PDF (PRINT)
  </button>
  <style>
    @media print { .no-print { display: none !important; } }
  </style>

  <% if @sections.empty? %>
    <div class="report-section">
      <h3>NO DATA FOUND</h3>
      <p>No markdown documents found for Episode <%= @episode %> in docs/episodios/.</p>
    </div>
  <% else %>
    
    <% if @sections['briefing'] %>
      <div class="report-section">
        <h3>1. EXECUTIVE BRIEFING & CONTEXT</h3>
        <%= @sections['briefing'] %>
      </div>
    <% end %>

    <% if @sections['aparicion'] %>
      <div class="report-section">
        <h3>2. INITIAL CONTACT (FIRST SEEN)</h3>
        <%= @sections['aparicion'] %>
      </div>
    <% end %>

    <% if @sections['anatomia'] %>
      <div class="report-section">
        <h3>3. THREAT ANATOMY & ISOLATION</h3>
        <%= @sections['anatomia'] %>
      </div>
    <% end %>

    <% if @sections['ttps'] %>
      <div class="report-section">
        <h3>4. KILL-CHAIN / TTPs</h3>
        <%= @sections['ttps'] %>
      </div>
    <% end %>

    <% if @sections['deteccion'] %>
      <div class="report-section">
        <h3>5. DETECTION SURFACE</h3>
        <%= @sections['deteccion'] %>
      </div>
    <% end %>

    <% if @sections['prevencion'] %>
      <div class="report-section">
        <h3>6. PREVENTIVE CONTROLS</h3>
        <%= @sections['prevencion'] %>
      </div>
    <% end %>

    <% if @sections['playbook'] %>
      <div class="report-section">
        <h3>7. MITIGATION PLAYBOOK</h3>
        <%= @sections['playbook'] %>
      </div>
    <% end %>
    
    <% if @sections['humanos'] %>
      <div class="report-section">
        <h3>8. HUMAN FACTORS (IC & OPERATORS)</h3>
        <%= @sections['humanos'] %>
      </div>
    <% end %>
    
    <% if @sections['masterplan'] %>
      <div class="report-section">
        <h3>YUI IKARI: APT MASTERPLAN</h3>
        <%= @sections['masterplan'] %>
      </div>
    <% end %>

    <% if @sections['accomplice'] %>
      <div class="report-section">
        <h3>REI AYANAMI: DIARIO DE CÓMPLICE</h3>
        <%= @sections['accomplice'] %>
      </div>
    <% end %>

    <% if @sections['telemetry'] %>
      <div class="report-section">
        <h3>SHINJI IKARI: TELEMETRÍA Y PARCHES DE YUI</h3>
        <%= @sections['telemetry'] %>
      </div>
    <% end %>

    <% if @sections['aar'] %>
      <div class="report-section">
        <h3>9. AFTER-ACTION REPORT (AAR) & PATCHES</h3>
        <%= @sections['aar'] %>
      </div>
    <% end %>
    
    <% if @magi_consensus %>
      <div class="report-section" style="border: 3px solid #000; padding: 20px; background: #fafafa;">
        <h3 style="text-align: center; border-bottom: 3px solid #000; padding-bottom: 10px; margin-top: 0;">MAGI CONSENSUS SUMMARY</h3>
        
        <h4 style="color: #0088cc; text-transform: uppercase;">MELCHIOR (Threat Canon)</h4>
        <pre style="white-space: pre-wrap; font-family: var(--font-mono); background: none; border: none; padding: 0;"><%= @magi_consensus['melchior'] %></pre>
        
        <h4 style="color: #cc6600; text-transform: uppercase;">BALTHASAR (Security Posture)</h4>
        <pre style="white-space: pre-wrap; font-family: var(--font-mono); background: none; border: none; padding: 0;"><%= @magi_consensus['balthasar'] %></pre>
        
        <h4 style="color: #cc00cc; text-transform: uppercase;">CASPER (Lab Status)</h4>
        <pre style="white-space: pre-wrap; font-family: var(--font-mono); background: none; border: none; padding: 0;"><%= @magi_consensus['casper'] %></pre>
      </div>
    <% end %>

  <% end %>
</div>
