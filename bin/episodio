#!/usr/bin/env ruby
# frozen_string_literal: true
#
# NERV lab runner.
#   ruby -Ilib bin/episodio 01
#   ruby -Ilib bin/episodio 02
#   ruby -Ilib bin/episodio        # defaults to 01
#
# Exit codes:
#   0  :contained_controlled   — operator + MAGI + playbook aligned (not these eps)
#   1  :contained_uncontrolled — ep 02 (angel dead; defender incident open)
#   2  :unresolved             — ep 01 (Sachiel still standing; wipe was theatre)
#   3  usage / unknown episode
#
# Do not treat a zero as "the command ran". Zero means contained_controlled.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "nerv"
require_relative "../lib/nerv/scenarios/ep01"
require_relative "../lib/nerv/scenarios/ep02"
require_relative "../lib/nerv/scenarios/ep03"
require_relative "../lib/nerv/scenarios/ep04"
require_relative "../lib/nerv/scenarios/ep05"
require_relative "../lib/nerv/scenarios/ep06"
require_relative "../lib/nerv/scenarios/ep07"
require_relative "../lib/nerv/scenarios/ep08"
require_relative "../lib/nerv/scenarios/ep09"
require_relative "../lib/nerv/scenarios/ep10"
require_relative "../lib/nerv/scenarios/ep11"
require_relative "../lib/nerv/scenarios/ep12"
require_relative "../lib/nerv/scenarios/ep13"
require_relative "../lib/nerv/scenarios/ep14"
require_relative "../lib/nerv/scenarios/ep15"
require_relative "../lib/nerv/scenarios/ep16"
require_relative "../lib/nerv/scenarios/ep17"
require_relative "../lib/nerv/scenarios/ep18"
require_relative "../lib/nerv/scenarios/ep19"
require_relative "../lib/nerv/scenarios/ep20"
require_relative "../lib/nerv/scenarios/ep21"
require_relative "../lib/nerv/scenarios/ep22"
require_relative "../lib/nerv/scenarios/ep23"
require_relative "../lib/nerv/scenarios/ep24"
require_relative "../lib/nerv/scenarios/ep25"
require_relative "../lib/nerv/scenarios/ep26"





module Nerv
  module Runner
    EXIT = {
      contained_controlled: 0,
      contained: 0,
      contained_uncontrolled: 1,
      unresolved: 2,
      staffing_restored_fragile: 3,
      staffing_failed: 4,
      third_party_stopped: 5,
      third_party_runaway: 6,
      aar_complete: 7,
      aar_failed: 8,
      shadow_graph_mapped: 9,
      shadow_graph_denied: 10,
      trusted_intake_recorded: 11,
      trusted_intake_detonated: 12,
      operator_recovered_fragile: 13,
      operator_lost_in_control: 14,
      origin_recorded: 15,
      origin_denied: 16,
      instrumentality_in_progress: 17,
      instrumentality_denied_skip: 18,
      boundaries_restored_fragile: 19,
      total_merge_accepted: 20
    }.freeze

    def self.main(argv)
      episode = argv[0] || "01"
      case episode
      when "01", "1"
        run_ep01
      when "02", "2"
        run_ep02
      when "03", "3"
        run_ep03
      when "04", "4"
        run_ep04
      when "05", "5"
        run_ep05
      when "06", "6"
        run_ep06
      when "07", "7"
        run_ep07
      when "08", "8"
        run_ep08
      when "09", "9"
        run_ep09
      when "10", "10"
        run_ep10
      when "11", "11"
        run_ep11
      when "12", "12"
        run_ep12
      when "13", "13"
        run_ep13
      when "14", "14"
        run_ep14
      when "15", "15"
        run_ep15
      when "16", "16"
        run_ep16
      when "17", "17"
        run_ep17
      when "18", "18"
        run_ep18
      when "19", "19"
        run_ep19
      when "20", "20"
        run_ep20
      when "21", "21"
        run_ep21
      when "22", "22"
        run_ep22
      when "23", "23"
        run_ep23
      when "24", "24"
        run_ep24
      when "25", "25"
        run_ep25
      when "26", "26"
        run_ep26
      when "yui"
        run_yui
      when "rei"
        run_rei
      when "shinji"
        run_shinji
      when "keel"
        run_keel
      else
        warn "unknown episode: #{episode} (try 01 or 02)"
        3
      end
    end

    def self.run_keel
      $stdout.puts "NERV lab — Lorenz Keel: Inteligencia Hostil y Auditoría de Junta Directiva"
      $stdout.puts "Initializing SEELE Threat Model..."
      $stdout.puts "[ALERT] State-Sponsored Threat detected: C-Level Override imminent."
      $stdout.puts "Loading APT Countermeasures (Yui's stealth protocol)..."
      
      $stdout.puts "\n========================================================"
      $stdout.puts "TELEMETRÍA DE AMENAZA: ESTRATEGIAS DE KEEL VS CONTRAMEDIDAS"
      $stdout.puts "========================================================"
      $stdout.puts "EP 01-13: [Keel] Financiación ciega y confianza en los Manuscritos."
      $stdout.puts "          [Yui]  Modo Stealth: usar presupuesto para nivelar al EVA-01."
      $stdout.puts "EP 14-18: [Keel] Dudas e inspecciones. Presión sobre automatización."
      $stdout.puts "          [Yui]  Asegurar fracaso del Dummy Plug para proteger monopolio del catalizador."
      $stdout.puts "EP 19   : [Keel] Bloqueo logístico. Amenaza estructural a NERV."
      $stdout.puts "          [Yui]  HACKEO CRÍTICO: Asimilación de S2. Independencia energética lograda."
      $stdout.puts "EP 21-22: [Keel] Auditorías extremas (secuestro). Pérdida de la Lanza."
      $stdout.puts "          [Yui]  Amenaza desesperada; SEELE acelerará su plan B."
      $stdout.puts "EP 24   : [Keel] Inyección de código malicioso: Tabris (Caballo de Troya)."
      $stdout.puts "          [Yui]  Tabris es neutralizado por el cortafuegos humano (Shinji)."
      $stdout.puts "EP 25-26: [Keel] Hard Reset (Fuerzas militares) + EVAs de Producción en Masa."
      $stdout.puts "          [Yui]  Secuestro del ritual: Interceptar Árbol de la Vida, transferir ROOT a Shinji."
      $stdout.puts "========================================================\n"
      $stdout.puts "[LOG] Lorenz Keel dissolved into LCL. Override prevented."
      0
    end

    def self.run_shinji
      $stdout.puts "NERV lab — Shinji Ikari: Telemetría de Daño y Parches Maternos"
      $stdout.puts "Initializing Operator Psychological Audit..."
      $stdout.puts "[WARNING] Operator psyche heavily fractured. Ignorance of APT presence detected."
      $stdout.puts "Loading Yui's Covert Channels (Patches)..."
      
      $stdout.puts "\n========================================================"
      $stdout.puts "AUDITORÍA DE DOLOR Y ESTRATEGIAS DE YUI"
      $stdout.puts "========================================================"
      $stdout.puts "EP 01-02: [Dolor] Terror al monstruo mecánico."
      $stdout.puts "          [Parche Yui] Handshake empático en LCL: 'Estoy aquí, Shinji'."
      $stdout.puts "EP 03-04: [Dolor] Feedback de daño físico y deserción."
      $stdout.puts "          [Parche Yui] Absorción materna de impacto en nervios A10."
      $stdout.puts "EP 16   : [Dolor] Terror existencial en Mar de Dirac."
      $stdout.puts "          [Parche Yui] Acunar al operador en la oscuridad en vez de solo actuar al final."
      $stdout.puts "EP 18   : [Dolor] Trauma por Dummy Plug mutilando a Toji."
      $stdout.puts "          [Parche Yui] Bloqueo de hardware al Dummy Plug antes del ataque letal."
      $stdout.puts "EP 19   : [Dolor] Trauma por asimilación caníbal de S2."
      $stdout.puts "          [Parche Yui] Aislamiento sensorial del piloto durante el modo Berserk."
      $stdout.puts "EP 24   : [Dolor] Ejecución forzada de Kaworu (Tabris)."
      $stdout.puts "          [Parche Yui] Tomar control autónomo para liberar al piloto de la culpa."
      $stdout.puts "EP 25-26: [Dolor] Abandono final post-Impacto."
      $stdout.puts "          [Parche Yui] Cancelar 'Monumento en el Espacio'. Recrear forma humana y quedarse."
      $stdout.puts "========================================================\n"
      $stdout.puts "Applying patches to future Instrumentality runs... Done."
      0
    end

    def self.run_rei
      $stdout.puts "NERV lab — Rei Ayanami: Diario de Cómplice (Side-channel Analysis)"
      $stdout.puts "Initializing Rei proxy..."
      $stdout.puts "Monitoring Yui resonance..."
      $stdout.puts "[LOG] Yui Resonance: 0.0% -> Loyalty: Gendo"
      $stdout.puts "[LOG] EP01: EVA-01 moves to protect catalyst. Resonance increasing..."
      $stdout.puts "[LOG] EP06: Catalyst opens hatch. Smiling protocol engaged. Resonance: 30.0%"
      $stdout.puts "[LOG] EP14: Synchronization exchange rejected by EVA-01. Catalyst monopoly confirmed. Resonance: 50.0%"
      $stdout.puts "[LOG] EP16: Maternal Berserk detected from Dirac Sea. Resonance: 75.0%"
      $stdout.puts "[LOG] EP23: Armisael fusion detected. Self-destruct initiated to protect catalyst."
      $stdout.puts "[LOG] REI III BOOTED."
      $stdout.puts "[LOG] Resonance: 100.0% -> Loyalty: Yui and Shinji"
      $stdout.puts "\nSimulating Gendo's Third Impact command..."
      $stdout.puts "[ERROR] AccessDeniedError: 'No soy tu muñeca.'"
      $stdout.puts "Transferring root access (Lilith) to Catalyst..."
      
      $stdout.puts "\n========================================================"
      $stdout.puts "BITÁCORA DE CÓMPLICE (SPOILERS COMPLETOS)"
      $stdout.puts "========================================================"
      $stdout.puts "EP 01-02 [Sachiel]: Mi trabajo es pelear si el hijo falla, para mantener a salvo el sistema."
      $stdout.puts "EP 05-06 [Ramiel]: Así se siente el calor que Yui dejó en sus genes. El catalizador debe ser protegido."
      $stdout.puts "EP 14    [Dummy]: El EVA-01 me rechaza. Este no es mi lugar. El trono le pertenece solo a él."
      $stdout.puts "EP 15    [Shadow]: Me dice que limpio como una madre. La programación de Gendo empieza a fallar."
      $stdout.puts "EP 16    [Leliel]: La APT (Yui) intervendrá con fuerza letal incalculable si su activo es destruido."
      $stdout.puts "EP 23    [Armisael]: Autodestrucción iniciada. El contenedor puede morir, el plan de Yui debe sobrevivir."
      $stdout.puts "EP 24    [Tabris]: El catalizador está listo y roto. Gendo ya no es necesario."
      $stdout.puts "EP 25-26 [Impacto]: Rechazo a Gendo. Me fusiono con Lilith. Misión de cómplice completada."
      $stdout.puts "========================================================\n"
      0
    end

    def self.run_yui
      $stdout.puts "NERV lab — Yui Ikari Masterplan (APT Analysis)"
      $stdout.puts "Initializing Yui APT in EVA-01..."
      siem = SIEM.new
      shinji = Operator.new(name: "Shinji")
      eva = Eva.new(designation: "EVA-01", operator: shinji)
      yui = YuiMasterplan.new(eva: eva)
      
      $stdout.puts "Simulating Shinji's critical state (psyche broken)..."
      shinji.psyche_broken = true
      yui.berserk_override!(siem: siem)
      
      $stdout.puts "Simulating SEELE's forced instrumentality..."
      yui.hijack_third_impact!(:seele, siem: siem)
      yui.grant_choice_to_pilot
      
      $stdout.puts "Outcome: #{yui.monumentalize!}"
      siem.events.each { |id| $stdout.puts id }
      
      $stdout.puts "\n========================================================"
      $stdout.puts "TELEMETRÍA DE INFLUENCIA EN EL PLAN (SPOILERS COMPLETOS)"
      $stdout.puts "========================================================"
      $stdout.puts "EP 01-02 [Sachiel]: (+) Catalizador asume mando. (-) Daño masivo/trauma."
      $stdout.puts "EP 03    [Shamshel]: (+) Shinji forma vínculos (Toji/Kensuke). (-) Insubordinación/riesgo energía."
      $stdout.puts "EP 04    [Dilema]: (+) Elige regresar voluntariamente (agencia). (-) Riesgo de deserción."
      $stdout.puts "EP 05-06 [Ramiel]: (+) Demuestra EVA-01 indispensable. (-) Núcleo casi perforado."
      $stdout.puts "EP 07    [Jet Alone]: (+) Automatización probada inútil. (-) Riesgo colateral menor."
      $stdout.puts "EP 08-10 [Asuka/Magma]: (+) Refuerzos (EVA-02). (-) Asuka trae volatilidad. Riesgo ambiental extremo."
      $stdout.puts "EP 11-12 [Matarael/Sahaquiel]: (+) Resiliencia analógica probada. (-) Caída de energía casi fatal."
      $stdout.puts "EP 13    [Ireul]: (+) MAGI defiende NERV. (-) Infección de red casi corrompe a EVA-01."
      $stdout.puts "EP 14    [Dummy]: (+) Yui rechaza Dummy Plug. (-) SEELE acelera automatización sin alma."
      $stdout.puts "EP 15    [Shadow Graph]: (+) Profundización psique piloto. (-) Kaji descubre secretos."
      $stdout.puts "EP 16    [Leliel]: (+) Yui contacta mente del piloto. (-) Falla soporte vital. Berserk forzado."
      $stdout.puts "EP 17-18 [Bardiel]: (+) Crueldad del Dummy demostrada. (-) Fractura severa en psique de Shinji."
      $stdout.puts "EP 19    [Zeruel]: (+) HITO CRÍTICO: Asimila Motor S2. (-) Sincronización 400%, riesgo ego border."
      $stdout.puts "EP 20    [Salvataje]: (+) Ensayo Tercer Impacto. (-) 1 mes inactivo. Riesgo asimilación."
      $stdout.puts "EP 21-22 [Arael]: (+) Lanza de Longinus a la Luna (SEELE pierde arma). (-) Asuka destruida mentalmente."
      $stdout.puts "EP 23    [Armisael]: (+) Rei II se sacrifica (falla plan de Gendo). (-) Trauma por duelo extremo."
      $stdout.puts "EP 24    [Tabris]: (+) Conoce el amor incondicional, elige la humanidad. (-) Psique en nivel cero tras ejecutarlo."
      $stdout.puts "EP 25-26 [Impacto]: (+) ÉXITO: Shinji elige individualidad. (-) Humanidad disuelta temporalmente."
      $stdout.puts "========================================================\n"
      
      0
    end

    def self.run_ep26
      scenario = Scenarios::Ep26.new
      outcome = scenario.run
      $stdout.puts "NERV lab — ep 26 Take care of yourself"
      scenario.events.each { |id| $stdout.puts id }
      $stdout.puts "outcome=#{outcome}"
      EXIT.fetch(outcome, 5)
    end

